---
// Small inline icon set. Decorative by default; pass `label` to expose it.
interface Props {
  name: 'sun' | 'moon' | 'menu' | 'close' | 'arrow-right' | 'arrow-up-right' | 'mail' | 'linkedin' | 'dribbble' | 'file' | 'lock';
  label?: string;
  class?: string;
}
const { name, label, class: className } = Astro.props;

const stroke: Record<string, string> = {
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>',
  moon: '<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="M6 6l12 12M18 6L6 18"/>',
  'arrow-right': '<path d="M5 12h14M13 6l6 6-6 6"/>',
  'arrow-up-right': '<path d="M7 17L17 7M8 7h9v9"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>',
  file: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h6"/>',
  lock: '<rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>',
};

const fill: Record<string, string> = {
  linkedin: '<path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/>',
  dribbble: '<path d="M12 24C5.38 24 0 18.62 0 12S5.38 0 12 0s12 5.38 12 12-5.38 12-12 12zm10.12-10.36c-.35-.11-3.17-.95-6.38-.44 1.34 3.68 1.88 6.68 1.99 7.3a10.27 10.27 0 0 0 4.39-6.86zM16 21.76c-.15-.9-.75-4.04-2.19-7.77l-.07.02c-5.78 2.01-7.85 6.02-8.04 6.4A10.2 10.2 0 0 0 16 21.76zM4.4 19.17c.23-.4 3.04-5.05 8.33-6.76.13-.05.27-.09.4-.12-.26-.58-.54-1.16-.82-1.73-5.12 1.53-10.09 1.47-10.54 1.46v.31c0 2.63 1 5.04 2.63 6.84zM1.97 10.18c.46.01 4.68.03 9.47-1.24-1.7-3.02-3.53-5.56-3.8-5.92a10.27 10.27 0 0 0-5.67 7.16zM9.6 2.33c.28.38 2.14 2.91 3.82 6 3.65-1.37 5.19-3.44 5.38-3.7A10.2 10.2 0 0 0 9.6 2.33zm10.34 3.49c-.22.29-1.94 2.5-5.75 4.05.24.49.47.99.68 1.49l.24.57c3.43-.43 6.83.26 7.17.33a10.23 10.23 0 0 0-2.34-6.44z"/>',
};

const isFill = name in fill;
const body = isFill ? fill[name] : stroke[name];
---
<svg
  class={className}
  viewBox="0 0 24 24"
  width="20"
  height="20"
  fill={isFill ? 'currentColor' : 'none'}
  stroke={isFill ? 'none' : 'currentColor'}
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  focusable="false"
  {...(label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' })}
  set:html={body}
/>
