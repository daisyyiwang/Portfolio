---
interface Props {
  eyebrow?: string;
  title: string;
  id?: string;
}
const { eyebrow, title, id } = Astro.props;
---
<div class="c-section__head">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 class="c-section__title" id={id}>{title}</h2>
  {Astro.slots.has('default') && <p class="c-section__desc"><slot /></p>}
</div>
