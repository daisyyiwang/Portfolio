---
// Image beside a short block of text; stacks on small screens.
import { sharpImg } from '../../lib/imageSize';
interface Props {
  src: string;
  alt: string;
  reverse?: boolean;
}
const { src, alt, reverse = false } = Astro.props;
const img = sharpImg(src);
---
<div class:list={['c-split', { 'c-split--reverse': reverse }]}>
  <div class="c-figure__plate c-split__media">
    <img src={src} alt={alt} loading="lazy" decoding="async" {...img} />
  </div>
  <div class="c-split__text">
    <slot />
  </div>
</div>
