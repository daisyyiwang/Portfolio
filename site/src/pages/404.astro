---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
---
<BaseLayout title="Page not found" guard={false}>
  <section class="container c-notfound" aria-labelledby="notfound-title">
    <p class="c-notfound__code" aria-hidden="true">4<span>0</span>4</p>
    <p class="eyebrow">Error 404</p>
    <h1 class="c-notfound__title" id="notfound-title">This floor isn't on the elevator.</h1>
    <p class="c-notfound__lead">The page you're looking for was moved, refined, or never existed. Let's get you back to the work.</p>
    <div class="c-hero__actions">
      <Button href="/#work" icon="arrow-right">Back to work</Button>
      <Button href="/about/" variant="secondary">About me</Button>
    </div>
  </section>
</BaseLayout>
